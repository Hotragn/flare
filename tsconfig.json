{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/server/test/**/*.ts",
    "apps/hub/src/**/*.ts",
    "apps/hub/field/**/*.ts",
    "apps/hub/test/**/*.ts",
    "apps/web/src/lib/ai/**/*.ts",
    "apps/web/src/lib/conditions/**/*.ts",
    "apps/web/src/lib/capabilities/**/*.ts",
    "apps/web/test/ai/**/*.ts",
    "apps/web/test/fakes/**/*.ts",
    "apps/web/test/e2e/**/*.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts"
  ]
}
