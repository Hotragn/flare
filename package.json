{
  "name": "flare-outside",
  "private": true,
  "version": "0.1.0",
  "description": "Flare: snap where you are; if enough friends quietly say yes, it's on.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check-env": "node scripts/check-env.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run -w apps/web check",
    "test": "npm exec -w apps/web -- svelte-kit sync && vitest run && vitest run --config apps/web/test/flow/vitest.config.ts && vitest run --config apps/web/test/site/vitest.config.ts",
    "build": "npm run -w apps/web build",
    "contracts": "node scripts/check-contracts.ts",
    "dev:server": "node --watch apps/server/src/main.ts",
    "dev:hub": "node --watch apps/hub/src/main.ts",
    "dev:web": "npm run -w apps/web dev",
    "start": "node apps/server/src/main.ts",
    "hub": "node apps/hub/src/main.ts",
    "hub:field": "node apps/hub/field/field.ts",
    "e2e:hello": "node scripts/e2e-hello.ts",
    "sweep": "node apps/server/src/cli/sweep.ts",
    "audit": "node apps/server/src/cli/audit.ts",
    "kpi": "node apps/server/src/cli/kpi.ts",
    "audit:logs": "node apps/server/src/cli/audit-logs.ts",
    "ci": "npm run secret-scan && npm run lint && npm run typecheck && npm test && npm run contracts && npm run build && npm run budget && npm run diagrams",
    "secret-scan": "node scripts/secret-scan.ts",
    "budget": "node scripts/budget.ts",
    "hooks": "git config core.hooksPath .githooks",
    "diagrams": "node scripts/check-diagrams.ts",
    "device-check": "node scripts/device-check.ts",
    "e2e:pwa": "node apps/web/test/pwa/e2e/offline.ts",
    "e2e:sw-update": "node apps/web/test/pwa/e2e/sw-update.ts",
    "eval": "node evals/harness/run.ts",
    "telegram:webhook": "node scripts/telegram-webhook.ts",
    "telegram:status": "node scripts/telegram-status.ts",
    "deploy:render": "node scripts/deploy-render.ts",
    "smoke": "node scripts/smoke.ts",
    "scan-sessions": "node scripts/scan-sessions.ts",
    "e2e:field": "node scripts/e2e-field.ts",
    "e2e:sparks": "node apps/web/test/e2e/sparks.ts",
    "e2e:loop": "node apps/web/test/e2e/loop.ts",
    "e2e:telegram": "node apps/web/test/e2e/telegram.ts",
    "gen:guide": "node scripts/gen-guide.ts",
    "e2e:kit-a11y": "node apps/web/test/e2e/kit-a11y.ts",
    "e2e:demo": "node apps/web/test/e2e/demo.ts",
    "e2e:photo-fit": "node apps/web/test/e2e/photo-fit.ts",
    "e2e:plan": "node apps/web/test/e2e/plan.ts",
    "e2e:voice": "node apps/web/test/e2e/voice-flare.ts",
    "e2e:cloud-only": "node apps/web/test/e2e/cloud-only.ts",
    "e2e:remember": "node apps/web/test/e2e/remember.ts",
    "e2e:no-keys": "node apps/web/test/e2e/cloud-only.ts --no-keys",
    "scenic": "node scripts/scenic.ts",
    "sim": "node tools/sim/run.ts",
    "sim:frames": "node tools/sim/frames.ts",
    "sim:gif": "node tools/sim/gif.ts"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.3",
    "@biomejs/biome": "2.5.15",
    "@redocly/cli": "2.62.1",
    "@types/node": "24.19.2",
    "gifenc": "1.0.3",
    "mermaid": "12.1.0",
    "playwright-core": "1.64.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "fsevents": false
  },
  "overrides": {
    "@sveltejs/kit": "3.0.1",
    "katex": "0.19.0"
  }
}
