# Copy to .env and fill in. Never commit .env. `npm run check-env` reports set or missing only.
# Server
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_URL=
# Shared secret the hub uses to open the relay socket (32+ random bytes, base64url)
HUB_SECRET=
# Hub (runs on the Mac next to Ollama)
FLARE_SERVER_URL=ws://localhost:8787
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
# Web Push (ADR-0014). Make a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/Hotragn/flare-outside
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Render (deploy automation only)
RENDER_KEY=
# Test area (map pack)
TEST_AREA_NAME=Fairlane
TEST_AREA_LAT=42.3169092
TEST_AREA_LON=-83.2229394
TEST_AREA_RADIUS_KM=3
# Not used: storage decision ADR-0004 picked Postgres. Kept for reference.
MONGODB_URI=
MONGODB_DB=
