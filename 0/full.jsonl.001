t);\n}\n\n/** Ask line to four steps'''),\n])\nedit('apps/hub/src/client.ts',[\n('''import { draftFromPhoto, draftFromVoice, isModelReady, ladderFromAsk, type OllamaConfig, tagsFromPhoto } from \"./ollama.ts\";''','''import {\n  draftFromPhoto,\n  draftFromVoice,\n  isModelReady,\n  ladderFromAsk,\n  type OllamaConfig,\n  summaryFromTranscript,\n  tagsFromPhoto,\n} from \"./ollama.ts\";'''),\n('''  const connect = () => {''','''  // ADR-0031: a consented transcript to one line; the text lives only in this call.\n  const runSummary = async (job: { id: string; text: string }, arrived: number) => {\n    const t = performance.now();\n    let result: HubResult;\n    try {\n      const left = remaining(arrived, \"ladder\");\n      if (left <= 0) throw Object.assign(new Error(\"stale\"), { name: \"TimeoutError\" });\n      const line = await summaryFromTranscript(opts.ollama, job.text, AbortSignal.timeout(left));\n      result = line\n        ? { ...base(job.id, t), ok: true, summary: line }\n        : { ...base(job.id, t), ok: false, error: \"unusable_answer\" };\n    } catch (e) {\n      result = { ...base(job.id, t), ok: false, error: isTimeout(e) ? \"timeout\" : \"model_unavailable\" };\n    }\n    send(result, \"summary-draft\");\n  };\n\n  const connect = () => {'''),\n('''        else {\n          const arrived = performance.now();\n          enqueue(() => runLadder(msg, arrived));\n        }''','''        else if (msg.kind === \"summary-draft\") {\n          const arrived = performance.now();\n          enqueue(() => runSummary(msg, arrived));\n        } else {\n          const arrived = performance.now();\n          enqueue(() => runLadder(msg, arrived));\n        }'''),\n])\nedit('apps/server/src/hub/relay.ts',[('''  /** ADR-0028: what the host said''','''  /** ADR-0031: a consented transcript to one line on the hub (asyncapi summaryJob, 8 s). Text only. */\n  summary(text: string, timeoutMs: number): Promise<RelayResult | null> {\n    const id = randomUUID();\n 