{"parentUuid":"77bffae2-6a52-4c80-8ffd-09224f8d0c16","isSidechain":false,"promptId":"e567af3c-70c1-46ba-b5a8-ec342a0e3f0d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WdwRE46Ngc75F5WJi3NoL2","type":"tool_result","content":"            type: \"result\",\n            id: pending,\n            ok: true,\n            draft: { invite: MARK_INVITE, alt: \"A wooden bench beside Marigold Lake at sunset.\" },\n            ms: 800,\n            model: \"gemma4:e4b-it-q4_K_M\",\n          }),\n        );\n      pending = null;\n    });\n    ws.on(\"error\", reject);\n  });\n\nconst serialize = (x: unknown) => JSON.stringify(x, (_k, v) => (v instanceof Uint8Array ? `<${v.length} bytes>` : v));\n\ndescribe(\"Sentry agent tracing (ADR-0021)\", () => {\n  it(\"starts only with a real DSN, never with an auth token\", () => {\n    expect(isDsn(\"https://[email]/42\")).toBe(true);\n    expect(isDsn(`sntryu_${\"a\".repeat(64)}`)).toBe(false);\n    expect(initTracing({ SENTRY_DSN: `sntryu_${\"a\".repeat(64)}` })).toBe(false);\n  });\n  it(\"scrubAttributes keeps only allow-listed short tokens\", () => {\n    expect(\n      scrubAttributes({ \"flare.tier\": \"hub\", \"http.url\": \"/api/v1/gatherings/x\", \"flare.error\": \"a b c\" }),\n    ).toEqual({\n      \"flare.tier\": \"hub\",\n    });\n    expect(ALLOWED.has(\"gen_ai.input.messages\")).toBe(false);\n  });\n\n  it(\"traces photo and ladder jobs with tier and model, and sends nothing personal\", async () => {\n    const s = await startServer();\n    const hub = await hubFor(s.ws);\n    const photo = fakeJpeg(4096);\n    const r1 = await (\n      await fetch(`${s.base}/api/v1/drafts`, { method: \"POST\", headers: { \"content-type\": \"image/jpeg\" }, body: photo })\n    ).json();\n    const r2 = await (\n      await fetch(`${s.base}/api/v1/drafts/ladder`, {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\", \"idempotency-key\": \"trace-test-key-0001\" },\n        body: JSON.stringify({ ask: MARK_ASK, total_minutes: 60 }),\n      })\n    ).json();\n    expect(r1.tier).toBe(\"hub\");\n    expect(r2.tier).toBe(\"hub\");\n    hub.close();\n    await s.close();\n    await flushTracing(3000);\n\n    const all = serialize(sent);\n    // Arrived: the AI spans and their allow-listed outcome.\n    expect(all).toContain(\"invoke_agent flare-photo\");\n    expect(all).toContain(\"invoke_agent flare-ladder\");\n    expect(all).toContain(\"chat gemma4:e4b-it-q4_K_M\");\n    expect(all).toContain(\"execute_tool enforce\");\n    expect(all).toContain('\"flare.tier\"');\n    // Never: text, ask lines, photo bytes, URLs, headers, ids, IPs.\n    for (const bad of [\n      MARK_INVITE,\n      \"Zebracorn\",\n      \"Marigold\",\n      MARK_ASK,\n      \"Quokka\",\n      \"Hollyhock\",\n      \"/api/v1\",\n      \"authorization\",\n      \"idempotency\",\n      \"127.0.0.1\",\n      \"user-agent\",\n    ])\n      expect(all, bad).not.toContain(bad);\n    expect(all).not.toMatch(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/); // no UUIDs (ids)\n    expect(all).not.toContain(`<${photo.length} bytes>`);\n  });\n});","is_error":false}]},"uuid":"70942783-7cee-4182-a9e8-da23e5421a60","timestamp":"2026-10-11T19:08:48.749Z","toolUseResult":{"stdout":"            type: \"result\",\n            id: pending,\n            ok: true,\n            draft: { invite: MARK_INVITE, alt: \"A wooden bench beside Marigold Lake at sunset.\" },\n            ms: 800,\n            model: \"gemma4:e4b-it-q4_K_M\",\n          }),\n        );\n      pending = null;\n    });\n    ws.on(\"error\", reject);\n  });\n\nconst serialize = (x: unknown) => JSON.stringify(x, (_k, v) => (v instanceof Uint8Array ? `<${v.length} bytes>` : v));\n\ndescribe(\"Sentry agent tracing (ADR-0021)\", () => {\n  it(\"starts only with a real DSN, never with an auth token\", () => {\n    expect(isDsn(\"https://[email]/42\")).toBe(true);\n    expect(isDsn(`sntryu_${\"a\".repeat(64)}`)).toBe(false);\n    expect(initTracing({ SENTRY_DSN: `sntryu_${\"a\".repeat(64)}` })).toBe(false);\n  });\n  it(\"scrubAttributes keeps only allow-listed short tokens\", () => {\n    expect(\n      scrubAttributes({ \"flare.tier\": \"hub\", \"http.url\": \"/api/v1/gatherings/x\", \"flare.error\": \"a b c\" }),\n    ).toEqual({\n      \"flare.tier\": \"hub\",\n    });\n    expect(ALLOWED.has(\"gen_ai.input.messages\")).toBe(false);\n  });\n\n  it(\"traces photo and ladder jobs with tier and model, and sends nothing personal\", async () => {\n    const s = await startServer();\n    const hub = await hubFor(s.ws);\n    const photo = fakeJpeg(4096);\n    const r1 = await (\n      await fetch(`${s.base}/api/v1/drafts`, { method: \"POST\", headers: { \"content-type\": \"image/jpeg\" }, body: photo })\n    ).json();\n    const r2 = await (\n      await fetch(`${s.base}/api/v1/drafts/ladder`, {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\", \"idempotency-key\": \"trace-test-key-0001\" },\n        body: JSON.stringify({ ask: MARK_ASK, total_minutes: 60 }),\n      })\n    ).json();\n    expect(r1.tier).toBe(\"hub\");\n    expect(r2.tier).toBe(\"hub\");\n    hub.close();\n    await s.close();\n    await flushTracing(3000);\n\n    const all = serialize(sent);\n    // Arrived: the AI spans and their allow-listed outcome.\n    expect(all).toContain(\"invoke_agent flare-photo\");\n    expect(all).toContain(\"invoke_agent flare-ladder\");\n    expect(all).toContain(\"chat gemma4:e4b-it-q4_K_M\");\n    expect(all).toContain(\"execute_tool enforce\");\n    expect(all).toContain('\"flare.tier\"');\n    // Never: text, ask lines, photo bytes, URLs, headers, ids, IPs.\n    for (const bad of [\n      MARK_INVITE,\n      \"Zebracorn\",\n      \"Marigold\",\n      MARK_ASK,\n      \"Quokka\",\n      \"Hollyhock\",\n      \"/api/v1\",\n      \"authorization\",\n      \"idempotency\",\n      \"127.0.0.1\",\n      \"user-agent\",\n    ])\n      expect(all, bad).not.toContain(bad);\n    expect(all).not.toMatch(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/); // no UUIDs (ids)\n    expect(all).not.toContain(`<${photo.length} bytes>`);\n  });\n});","stderr":"","interrupted":false,"isImage":false,"returnCodeInterpretation":"No matches found","noOutputExpected":false},"serverClassifierContext":{"request":"568e4bda-7d9f-44d3-84df-5471e6fb42e9","context":{"git_state":{"cwd":"<project>/flare","root":"<project>/flare","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":14,"untracked":null,"untracked_normal":27},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/flare","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/flare","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/flare","visibility":"private"}]}},"live_cwd":"<project>/flare","platform":"macos"}},"sourceToolAssistantUUID":"77bffae2-6a52-4c80-8ffd-09224f8d0c16","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"<project>/flare","sessionId":"904c52d9-f200-4552-8ce5-05e400952efa","version":"2.1.295","gitBranch":"HEAD","slug":"wondrous-tumbling-meteor"}
