$state(10);\n  let error = $state(\"\");\n  let rec: Recording | null = null;\n  let tick: ReturnType<typeof setInterval> | undefined;\n  async function toggle() {\n    if (state === \"listening\") {\n      rec?.stop();\n      return;\n    }\n    error = \"\";\n    try {\n      rec = await startVoice();\n    } catch {\n      error = t(\"voiceFlare.fail\");\n      return;\n    }\n    state = \"listening\";\n    left = SPARK_MAX_MS / 1000;\n    tick = setInterval(() => (left = Math.max(0, left - 1)), 1000);\n    const clip = await rec.done;\n    clearInterval(tick);\n    rec = null;\n    state = \"working\";\n    const d = clip ? await draftVoice(clip) : null;\n    state = \"idle\";\n    if (d) ondraft?.(d);\n    else error = t(\"voiceFlare.fail\");\n  }\n  $effect(() => () => {\n    clearInterval(tick);\n    rec?.stop();\n  });\n</script>\n\n<div class=\"say\">\n  <Button variant=\"secondary\" icon=\"mic\" loading={state === \"working\"} onclick={toggle}>{state === \"listening\" ? t(\"spark.stop\") : t(\"voiceFlare.cta\")}</Button>\n  <p class=\"t-small\" role=\"status\" aria-live=\"polite\">{state === \"listening\" ? t(\"spark.listening\", { s: left }) : state === \"working\" ? t(\"voiceFlare.working\") : error || t(\"voiceFlare.note\")}</p>\n</div>\n\n<style>\n  .say { display: flex; flex-direction: column; gap: 6px; align-items: stretch; width: 100%; }\n  .say p { margin: 0; text-align: center; }\n</style>\n''')\np='design/prototype/src/lib/copy/deck.json'\ns=open(p).read()\nitems=[(\"voiceFlare.cta\",\"Say where you are\",\"button\"),(\"voiceFlare.note\",\"Or say it: where you are and what to do.\",\"hint\"),(\"voiceFlare.working\",\"Writing your invite…\",\"status\"),(\"voiceFlare.fail\",\"Didn't catch a place. Take a photo or try again.\",\"error\")]\nadd=''.join(f'    {json.dumps(k)}: {{\\n      \"text\": {json.dumps(v)},\\n      \"kind\": \"{kind}\",\\n      \"where\": \"H1 camera, Voice Flare (ADR-0028)\"\\n    }},\\n' for k,v,kind in items)\ns=s.replace('  