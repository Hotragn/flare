 nothing clear was said, reply {\"line\": \"\"}.',\n].join(\"\\n\");\n\nexport const summaryUserPrompt = (transcript: string) => `Transcript:\\n${transcript.slice(0, 4000)}\\n\\nReply with the JSON.`;\n\n/** The guard both the hub and the server run. Returns the line or null. */\nexport function enforceSummary(raw: string): string | null {\n  const m = /\\{[\\s\\S]*\\}/.exec(raw);\n  if (!m) return null;\n  let line: unknown;\n  try {\n    line = (JSON.parse(m[0]) as { line?: unknown }).line;\n  } catch {\n    return null;\n  }\n  if (typeof line !== \"string\") return null;\n  const s = line.replace(/[\"“”]/g, \"\").replace(/\\s+/g, \" \").trim();\n  const words = s.split(\" \").filter(Boolean).length;\n  if (words < 3 || words > 16) return null;\n  if (/speaker\\s*\\d/i.test(s) || /\\d[\\d\\s-]{6,}\\d/.test(s) || /@|https?:/i.test(s)) return null;\n  return s.slice(0, 140);\n}\nEOF\npython3 - <<'EOF'\ndef edit(p, pairs):\n  s=open(p).read()\n  for a,b in pairs:\n    assert a in s,(p,a); s=s.replace(a,b,1)\n  open(p,'w').write(s)\nedit('packages/shared/src/index.ts',[('export * from \"./prompts/voice.ts\";','export * from \"./prompts/voice.ts\";\\nexport * from \"./prompts/summary.ts\";')])\nedit('packages/shared/src/hub-protocol.ts',[\n('''export const HubLadderStep''','''/** Remember this (ADR-0031, asyncapi `summaryJob`): a consented transcript to one line. Text only, 8 s. */\nexport const SummaryJob = z.object({\n  type: z.literal(\"job\"),\n  id: z.string().uuid(),\n  kind: z.literal(\"summary-draft\"),\n  text: z.string().min(1).max(4000),\n});\n\nexport const HubLadderStep'''),\n('''  tags: z.record(z.string(), z.string()).optional(), // ICR-ML5, after enforceOsmTags''','''  tags: z.record(z.string(), z.string()).optional(), // ICR-ML5, after enforceOsmTags\n  summary: z.string().max(140).optional(), // ADR-0031, after enforceSummary'''),\n('''export const ToHubV11 = z.union([JobHeader, LadderJob, TagsJob, VoiceJob, Ping]);''','''export const ToHubV11 = z.un