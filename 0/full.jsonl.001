{"parentUuid":"c6a696fb-aee0-4a9b-b4c6-bb94c343927a","isSidechain":false,"promptId":"e567af3c-70c1-46ba-b5a8-ec342a0e3f0d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J6veLNJFHimS7idJf3FTg2","type":"tool_result","content":"<!-- Home (W1 hero, W2 steps, W3 shrink, then short W4 to W6 with links to the full pages). -->\n<script lang=\"ts\">\n  import Scenery from \"#lib/components/Scenery.svelte\";\n  import Icon from \"#lib/components/Icon.svelte\";\n  import { t, type CopyKey } from \"#lib/copy/index.ts\";\n  import Seo from \"./Seo.svelte\";\n  import Steps from \"./Steps.svelte\";\n  import Shrink from \"./Shrink.svelte\";\n  import { reveal } from \"./reveal.ts\";\n\n  const promises: CopyKey[] = [\"site.privacy.p1\", \"site.privacy.p2\", \"site.privacy.p3\", \"site.privacy.p4\", \"site.privacy.p5\"];\n  const access: [string, CopyKey][] = [[\"bench\", \"site.access.a1\"], [\"steps\", \"site.access.a2\"], [\"compass\", \"site.access.a3\"], [\"info\", \"site.access.a4\"], [\"card\", \"site.access.a5\"]];\n</script>\n\n<Seo path=\"/\" />\n\n<section class=\"hero\">\n  <div class=\"hero-art\" aria-hidden=\"true\"><Scenery width={1200} height={640} /></div>\n  <picture class=\"hero-shot\">\n    <source type=\"image/avif\" srcset=\"/site/hero-invite.avif\" />\n    <img src=\"/site/hero-invite.webp\" width=\"360\" height=\"779\" alt={t(\"site.hero.shotAlt\")} fetchpriority=\"low\" decoding=\"async\" />\n  </picture>\n  <div class=\"hero-copy\">\n    <p class=\"kicker\">{t(\"site.hero.kicker\")}</p>\n    <h1 class=\"t-display\">{t(\"site.hero.title\")}</h1>\n    <p class=\"lead\">{t(\"site.hero.lead\")}</p>\n    <div class=\"ctas\">\n      <a class=\"cta primary\" href=\"/app/demo/\">{t(\"demo.try\")}</a>\n      <a class=\"cta\" href=\"/app/\">{t(\"site.nav.open\")}</a>\n    </div>\n    <p class=\"fine\">{t(\"site.hero.fine\")}</p>\n  </div>\n</section>\n\n<section class=\"band\" use:reveal>\n  <Steps />\n  <p class=\"more\"><a href=\"/how/\">{t(\"site.home.readHow\")}</a></p>\n</section>\n\n<section class=\"band alt\" use:reveal>\n  <Shrink />\n</section>\n\n<section class=\"band\" use:reveal>\n  <h2 class=\"t-title\">{t(\"site.privacy.title\")}</h2>\n  <ul class=\"checks\">\n    {#each promises as key}<li><Icon name=\"here\" /><span>{t(key)}</span></li>{/each}\n  </ul>\n  <p class=\"more\"><a href=\"/privacy/\">{t(\"site.home.readPrivacy\")}</a></p>\n</section>\n\n<section class=\"band alt\" use:reveal>\n  <h2 class=\"t-title\">{t(\"site.access.title\")}</h2>\n  <ul class=\"checks\">\n    {#each access as [icon, key]}<li><Icon name={icon} /><span>{t(key)}</span></li>{/each}\n  </ul>\n  <p class=\"more\"><a href=\"/accessibility/\">{t(\"site.home.readAccess\")}</a></p>\n</section>\n\n<section class=\"band\" use:reveal>\n  <h2 class=\"t-title\">{t(\"site.run.title\")}</h2>\n  <p>{t(\"site.run.body\")}</p>\n  <p class=\"more\"><a href=\"/run/\">{t(\"site.home.readRun\")}</a></p>\n</section>\ndocs/design/redesign/after/:\n00-home.jpg\n01-host-send.jpg\n01-host-sent.jpg\n01-host-words.jpg\n02-friend-invite.jpg\n03-friend-lit.jpg\n03-host-lit.jpg\n04-friend-compass.jpg\n05-friend-spark.jpg\n06-friend-ember.jpg\n06-host-ember.jpg\n07-telegram-card-kindling.png\n07-telegram-card-lit.png\ncrew.jpg\ndemo-1-send.jpg\ndemo-2-kindling.jpg\ndemo-2a-friend.jpg\ndemo-3-ember-lit.jpg\ndemo-4-compass.jpg\ndemo-5-spark.jpg\ndemo-6-outside.jpg\ndemo-7-away.jpg\ndemo-8-done.jpg\ndemo-fail.jpg\n\ndocs/frontend/evidence/:\ne2e-flow.txt\ne2e-h4-sent.png\ne2e-h6-lit.png\ne2e-i1-met-here.png\ne2e-i4-in.png\ne2e-i6-lit.png\ne2e-i7-compass.png\ne2e-o1-hotspots.png\ne2e-o5-card.pdf\ne2e-o5-loop.png\ne2e-o5-none.png\ne2e-o6-fixmap-photo.png\ne2e-o6-fixmap.png\ne2e-o7-telegram.png\ne2e-p2-ladder.png\ne2e-p4-condition-in.png\ne2e-p5-plan-lit.png\ne2e-p6-faded.png\ne2e-plan-fail-amor.png\ne2e-plan-fail-host.png\ne2e-plan-fail-kai.png\ne2e-sparks-fail-friend.png\ne2e-sparks-fail-host.png\ne2e-telegram-fail.png\nflow-real.txt\nsparks