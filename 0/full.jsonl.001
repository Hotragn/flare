{"parentUuid":"356ed073-eaf3-40d9-99df-efa7a0c082ed","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfvwjoSYNh5743LyXpyqq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Bu4qAZm2ZGq5Wri3QqTELS","name":"Bash","input":{"command":"cd \"<project>/flare\" && cat > packages/shared/src/prompts/voice.ts <<'EOF'\n// Voice Flare prompt v1 (ADR-0028): the host says where they are and what they want to do, and\n// Gemma 4 on the hub writes the same {invite, alt} a photo would get, from the audio alone.\n// Same guard as photos (enforce() in photo.ts). Checked on the hub's gemma4:e4b on 2026-10-11:\n// \"I'm at the pond in Ford Woods Park. Come sit on the bench with me...\" gave\n// {\"invite\": \"Meet at the pond bench.\", \"alt\": \"The pond in Fordwoods Park has nice light to sit\n// on the bench.\"} in 3.7 s.\n\nexport const VOICE_SYSTEM_PROMPT = [\n  \"You write invites for Flare, an app that gets close friends to meet up outside, right now.\",\n  \"Listen to the person. They say where they are and what they want to do. Reply with one JSON object only. No code fences, no other text.\",\n  '{\"invite\": \"...\", \"alt\": \"...\"}',\n  \"invite: 3 to 6 words, never more. A warm call to meet at the place they said.\",\n  \"alt: 8 to 20 words. A plain spoken description of the place, from what they said, for a friend who cannot see it.\",\n  \"Use only places and things they said. Do not invent water, food, drinks or activities they did not say.\",\n  \"Never include people's names, faces, bodies, clothing, age or gender. No emoji, no hashtags.\",\n  'If you cannot hear a place, reply {\"invite\": \"\", \"alt\": \"\"}.',\n].join(\"\\n\");\n\nexport const VOICE_USER_PROMPT = \"Here is what they said. Reply with the JSON.\";\n\n/** 16 kHz mono 16-bit WAV, at most 12 s (the phone stops at 10 s). */\nexport const MAX_VOICE_WAV_BYTES = 400_000;\nEOF\npython3 - <<'EOF'\ndef edit(p, pairs):\n  s=open(p).read()\n  for a,b in pairs:\n    assert a in s,(p,a); s=s.replace(a,b,1)\n  open(p,'w').write(s)\nedit('packages/shared/src/index.ts',[('export * from \"./prompts/rest-loop.ts\";','export * from \"./prompts/rest-loop.ts\";\\nexport * from \"./prompts/voice.ts\";')])\nedit('packages/shared/src/hub-protocol.ts',[\n('''export const TagsJob = JobHeader.extend({ kind: z.literal(\"tags-draft\") });''','''export const TagsJob = JobHeader.extend({ kind: z.literal(\"tags-draft\") });\n\n/** Voice Flare (ADR-0028, asyncapi `voiceJob`): header frame, then one 16 kHz mono WAV frame\n * of the host saying where they are; 8 s budget. The audio lives only in memory. */\nexport const VoiceJob = JobHeader.extend({\n  kind: z.literal(\"voice-draft\"),\n  mime: z.literal(\"audio/wav\"),\n  bytes: z.number().int().positive().max(400_000),\n});'''),\n('''  error: z.enum([\"model_unavailable\", \"unusable_answer\", \"timeout\", \"bad_image\"]).optional(),''','''  error: z.enum([\"model_unavailable\", \"unusable_answer\", \"timeout\", \"bad_image\", \"bad_audio\"]).optional(),'''),\n('''export const ToHubV11 = z.union([JobHeader, LadderJob, TagsJob, Ping]);''','''export const ToHubV11 = z.union([JobHeader, LadderJob, TagsJob, VoiceJob, Ping]);'''),\n('''export type TagsJobT = z.infer<typeof TagsJob>;''','''export type TagsJobT = z.infer<typeof TagsJob>;\nexport type VoiceJobT = z.infer<typeof VoiceJob>;'''),\n])\nedit('apps/hub/src/ollama.ts',[\n('''  USER_PROMPT,\n} from \"@flare/shared\";''','''  USER_PROMPT,\n  VOICE_SYSTEM_PROMPT,\n  VOICE_USER_PROMPT,\n} from \"@flare/shared\";'''),\n('''/** Ask line to four steps''','''/**\n * Voice Flare (ADR-0028): what the host said, as WAV, to the same guarded draft as a photo.\n * Gemma 4 takes audio through Ollama's `images` field (checked on Ollama 0.40.2). No retry: at\n * temperature 0 a second try gives the same answer, and the host can type instead.\n */\nexport async function draftFromVoice(cfg: OllamaConfig, wav: Uint8Array, signal?: AbortSignal): Promise<Draft | null> {\n  const text = await post(\n    cfg,\n    [\n      { role: \"system\", content: VOICE_SYSTEM_PROMPT },\n      { role: \"user\", content: VOICE_USER_PROMPT, images: [Buffer.from(wav).toString(\"base64\")] },\n    ],\n    128,\n    signal,\n  );\n  return enforce(text);\n}\n\n/** Ask line to four steps'''),\n])\nedit('apps/hub/src/client.ts',[\n('''import { draftFromPhoto, isModelReady, ladderFromAsk, type OllamaConfig, tagsFromPhoto } from \"./ollama.ts\";''','''import { draftFromPhoto, draftFromVoice, isModelReady, ladderFromAsk, type OllamaConfig, tagsFromPhoto } from \"./ollama.ts\";'''),\n('''  budgetMs?: { photo?: number; ladder?: number; tags?: number };''','''  budgetMs?: { photo?: number; ladder?: number; tags?: number; voice?: number };'''),\n('''  let waitingFor: { id: string; bytes: number; kind: \"photo-draft\" | \"tags-draft\" } | null = null;''','''  let waitingFor: { id: string; bytes: number; kind: \"photo-draft\" | \"tags-draft\" | \"voice-draft\" } | null = null;'''),\n('''    tags: opts.budgetMs?.tags ?? 8000,\n  };''','''    tags: opts.budgetMs?.tags ?? 8000,\n    voice: opts.budgetMs?.voice ?? 8000,\n  };'''),\n('''  const remaining = (arrived: number, kind: \"photo\" | \"ladder\" | \"tags\") =>''','''  const remaining = (arrived: number, kind: \"photo\" | \"ladder\" | \"tags\" | \"voice\") =>'''),\n('''  const runPhoto = async (job: NonNullable<typeof waitingFor>, photo: Buffer, arrived: number) => {\n    const t = performance.now();\n    const tags = job.kind === \"tags-draft\";\n    let result: HubResult;\n    try {\n      if (photo.length !== job.bytes || photo[0] !== 0xff || photo[1] !== 0xd8)\n        throw Object.assign(new Error(\"bad image\"), { code: \"bad_image\" });\n      const left = remaining(arrived, tags ? \"tags\" : \"photo\");\n      if (left <= 0) throw Object.assign(new Error(\"stale\"), { name: \"TimeoutError\" });\n      if (tags) {''','''  const runPhoto = async (job: NonNullable<typeof waitingFor>, photo: Buffer, arrived: number) => {\n    const t = performance.now();\n    const tags = job.kind === \"tags-draft\";\n    const voice = job.kind === \"voice-draft\"; // ADR-0028: the frame is WAV audio, not a JPEG\n    let result: HubResult;\n    try {\n      if (voice) {\n        if (photo.length !== job.bytes || photo.subarray(0, 4).toString(\"latin1\") !== \"RIFF\")\n          throw Object.assign(new Error(\"bad audio\"), { code: \"bad_audio\" });\n      } else if (photo.length !== job.bytes || photo[0] !== 0xff || photo[1] !== 0xd8)\n        throw Object.assign(new Error(\"bad image\"), { code: \"bad_image\" });\n      const left = remaining(arrived, voice ? \"voice\" : tags ? \"tags\" : \"photo\");\n      if (left <= 0) throw Object.assign(new Error(\"stale\"), { name: \"TimeoutError\" });\n      if (voice) {\n        const d = await draftFromVoice(opts.ollama, photo, AbortSignal.timeout(left));\n        result = d\n          ? { ...base(job.id, t), ok: true, draft: { invite: d.invite, alt: d.alt } }\n          : { ...base(job.id, t), ok: false, error: \"unusable_answer\" };\n      } else if (tags) {'''),\n('''      const code =\n        (e as { code?: string }).code === \"bad_image\" ? \"bad_image\" : isTimeout(e) ? \"timeout\" : \"model_unavailable\";''','''      const c = (e as { code?: string }).code;\n      const code = c === \"bad_image\" || c === \"bad_audio\" ? c : isTimeout(e) ? \"timeout\" : \"model_unavailable\";'''),\n('''        else if (msg.kind === \"photo-draft\" || msg.kind === \"tags-draft\")''','''        else if (msg.kind === \"photo-draft\" || msg.kind === \"tags-draft\" || msg.kind === \"voice-draft\")'''),\n])\nEOF\nnpx tsc -p . --noEmit 2>&1 | head -5","description":"Voice prompt, protocol job, hub handling","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1831,"cache_read_input_tokens":494367,"output_tokens":3376