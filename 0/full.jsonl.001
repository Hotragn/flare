    const seen: Seen[] = [];\n    const r = await runVoice('{\"invite\": \"Meet at the pond bench\", \"alt\": \"A pond in a park with a bench in warm evening light.\"}', seen);\n    expect(r).toMatchObject({ id: \"66666666-2b7a-4d8e-9c3f-1a2b3c4d5e6f\", ok: true });\n    expect(r.draft).toEqual({ invite: \"Meet at the pond bench\", alt: \"A pond in a park with a bench in warm evening light.\" });\n    expect(seen).toEqual([{ system: VOICE_SYSTEM_PROMPT, image: true }]);\n  });\n  it(\"no place heard: unusable_answer, so the phone asks the host to type\", async () => {\n    const r = await runVoice('{\"invite\": \"\", \"alt\": \"\"}', []);\n    expect(r).toMatchObject({ ok: false, error: \"unusable_answer\" });\n  });\n  it(\"a frame that is not WAV is bad_audio and never reaches the model\", async () => {\n    const seen: Seen[] = [];\n    const r = await runVoice(\"{}\", seen, Buffer.alloc(300, 1));\n    expect(r).toMatchObject({ ok: false, error: \"bad_audio\" });\n    expect(seen).toHaveLength(0);\n  });\n});\n'''\nopen('apps/hub/test/voice.test.ts','w').write(s)\nEOF\nnpx biome check --write apps/hub/test/voice.test.ts >/dev/null 2>&1; npx vitest run apps/hub/test 2>&1 | grep -E \"Tests |FAIL|✗\" | head","description":"Hub voice job tests","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1707,"cache_read_input_tokens":508893,"output_tokens":1454,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1707,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1454,"cache_read_input_tokens":508893,"cache_creation_input_tokens":1707,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1707},"type":"message"}],"speed":"standard","fal