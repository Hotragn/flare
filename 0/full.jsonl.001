card\", \"menu.loop\", \"menu.loopSub\"],\n    [\"mapfix\", \"menu.map\", \"menu.mapSub\"],\n    [\"info\", \"menu.check\", \"menu.checkSub\"],\n    [\"spark\", \"menu.ai\", \"menu.aiSub\"],\n    [\"close\", \"menu.forget\", \"menu.forgetSub\"],\n  ];\n</script>\n\n<Screen {theme} {wire} menu close={false} grain={false}>\n  <div class=\"dim\" aria-hidden=\"true\"></div>\n  {#snippet overlay()}\n    <Sheet inline title={t(\"menu.title\")}>\n      <ul class=\"menu\">\n        {#each items as [icon, label, sub]}\n          <li><button class=\"row\"><Icon name={icon} /><span class=\"txt\"><b>{t(label)}</b><span class=\"visually-hidden\">{t(\"app.pause\")}</span><span class=\"t-small t-muted\">{t(sub)}</span></span><Icon name=\"chevron\" size={20} /></button></li>\n        {/each}\n      </ul>\n      <p class=\"t-small t-muted foot\">{t(\"menu.foot\")}</p>","is_error":false}]},"uuid":"c19475a7-5d34-424a-96a9-0180b5a7fa69","timestamp":"2026-10-11T17:10:13.420Z","toolUseResult":{"stdout":"  // svelte-ignore state_referenced_locally\n  let sheet = $state<\"\" | \"text-yes\" | \"cancel\">(view === \"text-yes\" || view === \"cancel\" ? view : \"\");\n  let reply = $state(\"\");\n</script>\n\n<Screen {theme} sound {onclose} heading={t(\"host.kindling.heading\")} title={t(\"host.kindling.title\")} offline={savedAt ? t(\"app.offline\", { time: savedAt }) : \"\"} stage backdrop={photo} backdropAlt={scene} fallbackArt>\n  {#snippet hero()}\n    <div class=\"center\">\n      <CountRing {have} {quorum} size={190} />\n      <p class=\"t-muted\">{shrinkMin === null || have <= 1 ? (sentMin < 1 ? t(\"host.kindling.justSent\") : t(\"host.kindling.sentAgo\", { min: sentMin })) : t(\"host.kindling.shrinkIn\", { min: shrinkMin })}</p>\n    </div>\n  {/snippet}\n  {#if hostLine}<p class=\"hostline t-small\">{hostLine}</p>{/if}\n<style>\n  .center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 8px; }\n  .center p { marg