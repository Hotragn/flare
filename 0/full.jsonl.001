{"parentUuid":"11b4a93e-32d8-4826-a895-a2abdda41ed1","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cfvwf7ZKEdpvaYwkSJbGD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NimcxkLN84hfjSUqCo3p3R","name":"Bash","input":{"command":"cd \"<project>/flare\" && sed -n 1,120p apps/hub/src/ollama.ts; grep -n \"SYSTEM_PROMPT\\|USER_PROMPT\" packages/shared/src/prompts/index.ts | head; grep -rn \"export const SYSTEM_PROMPT\" -A20 packages/shared/src | head -40","description":"Read hub Ollama calls and the photo prompt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2198,"cache_read_input_tokens":479382,"output_tokens":381,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2198,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":381,"cache_read_input_tokens":479382,"cache_creation_input_tokens":2198,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2198},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01NimcxkLN84hfjSUqCo3p3R":{"command":"cd \"<project>/flare\" && sed -n 1,120p apps/hub/src/ollama.ts; grep -n \"SYSTEM_PROMPT\\|USER_PROMPT\" packages/shared/src/prompts/index.ts | head; grep -rn \"export const SYSTEM_PROMPT\" -A20 packages/shared/src | head -40","description":"Read hub Ollama calls and the photo prompt"}},"serverClassifierRequest":"5c95fb9b-672a-413d-9a2c-42dfe212cfaf","apiBlockIndex":1,"requestId":"req_011Cfvwf6UpurXRDqZ1mkwyX","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"12cbb170-e1d8-4a29-81da-6cac08292cbe","timestamp":"2026-10-11T18:43:44.478Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"<project>/flare","sessionId":"904c52d9-f200-4552-8ce5-05e400952efa","version":"2.1.295","gitBranch":"HEAD","slug":"wondrous-tumbling-meteor"}
{"parentUuid":"11b4a93e-32d8-4826-a895-a2abdda41ed1","isSidechain":false,"promptId":"e567af3c-70c1-46ba-b5a8-ec342a0e3f0d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012igATxpKtBPTyNBjVvK8UT","type":"tool_result","content":"// Hub relay protocol (docs/architecture/contracts/asyncapi.yaml, channel /hub).\n// The Mac hub opens an outbound WebSocket to the server; the server sends jobs.\n// Text frames carry JSON control messages; a photo job is one text frame (job header)\n// followed by one binary frame (the 768 px JPEG). Nothing on the Mac is exposed (ADR-0006).\nimport { z } from \"zod\";\n\nexport const HUB_PROTOCOL = \"flare-hub.v1\";\n\nexport const HelloFromHub = z.object({\n  type: z.literal(\"hello\"),\n  protocol: z.literal(HUB_PROTOCOL),\n  model: z.string().min(1),\n  ready: z.boolean(),\n});\n\nexport const JobHeader = z.object({\n  type: z.literal(\"job\"),\n  id: z.string().uuid(),\n  kind: z.literal(\"photo-draft\"),\n  bytes: z.number().int().positive().max(2_000_000),\n  mime: z.literal(\"image/jpeg\"),\n});\n\n/** ICR-BE-1: Plan ladder job (asyncapi `ladderJob`). Text only, 8 s budget. */\nexport const LadderJob = z.object({\n  type: z.literal(\"job\"),\n  id: z.string().uuid(),\n  kind: z.literal(\"ladder-draft\"),\n  ask: z.string().max(80),\n  total_minutes: z.number().int().min(40).max(600),\n  weather: z.object({ rain_likely: z.boolean(), temp_f: z.number().int() }).optional(),\n});\n\n/** ICR-ML5: Fix the map photo to OSM tags (asyncapi `tagsJob`). Header frame, then one JPEG\n * frame, like a photo job; 8 s budget. The tags are a draft a person reviews one by one. */\nexport const TagsJob = JobHeader.extend({ kind: z.literal(\"tags-draft\") });\n\nexport const HubLadderStep = z.object({\n  step: z.number().int().min(1).max(4),\n  label: z.string(),\n  minutes: z.number().int(),\n});\n\nexport const JobResult = z.object({\n  type: z.literal(\"result\"),\n  id: z.string().uuid(),\n  ok: z.boolean(),\n  draft: z.object({ invite: z.string().min(1), alt: z.string().min(1) }).optional(),\n  ladder: z.array(HubLadderStep).length(4).optional(), // ICR-BE-1\n  tags: z.record(z.string(), z.string()).optional(), // ICR-ML5, after enforceOsmTags\n  error: z.enum([\"model_unavailable\", \"unusable_answer\", \"timeout\", \"bad_image\"]).optional(),\n  ms: z.number().int().nonnegative(),\n  model: z.string(),\n});\n\nexport const Ping = z.object({ type: z.literal(\"ping\"), t: z.number() });\nexport const Pong = z.object({ type: z.literal(\"pong\"), t: z.number() });\n\nexport const FromHub = z.discriminatedUnion(\"type\", [HelloFromHub, JobResult, Pong]);\nexport const ToHub = z.discriminatedUnion(\"type\", [JobHeader, Ping]);\n      ws.terminate();\n    }\n  }, 1000);\n  watchdog.unref();\n  let waitingFor: { id: string; bytes: number; kind: \"photo-draft\" | \"tags-draft\" } | null = null;\n  // One model call at a time: Ollama is shared on this Mac, and order keeps results simple.\n  let queue: Promise<void> = Promise.resolve();\n  const enqueue = (fn: () => Promise<void>) => {\n    queue = queue.then(fn).catch(() => {});\n  };\n  const send = (r: HubResult, kind: string) => {\n    if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify(r));\n    say({ event: \"job\", kind, ok: r.ok, ms: r.ms });\n  };\n  const base = (id: string, t: number) => ({\n    type: \"result\" as const,\n    id,\n    ms: Math.round(performance.now() - t),\n    model: opts.ollama.model,\n  });\n\n  // The server stops waiting after 6 s (photo) or 8 s (ladder) and answers with the template\n  // (BR-AI-1). Past that, the hub's answer is useless and only delays the next job behind it,\n  // so each job gets the rest of its budget, counted from when it arrived, and is dropped at 0.\n  const budget = {\n    photo: opts.budgetMs?.photo ?? 6000,\n    ladder: opts.budgetMs?.ladder ?? 8000,\n    tags: opts.budgetMs?.tags ?? 8000,\n  };\n  // Whole milliseconds: AbortSignal.timeout() rejects fractions.\n  const remaining = (arrived: number, kind: \"photo\" | \"ladder\" | \"tags\") =>\n    Math.floor(budget[kind] - (performance.now() - arrived));\n  const isTimeout = (e: unknown) => [\"TimeoutError\", \"AbortError\"].includes((e as { name?: string }).name ?? \"\");\n\n  // Photo jobs (invite words, or OSM tags for Fix the map): same frames, different prompt.\n  const runPhoto = async (job: NonNullable<typeof waitingFor>, photo: Buffer, arrived: number) => {\n    const t = performance.now();\n    const tags = job.kind === \"tags-draft\";\n    let result: HubResult;\n    try {\n      if (photo.length !== job.bytes || photo[0] !== 0xff || photo[1] !== 0xd8)\n        throw Object.assign(new Error(\"bad image\"), { code: \"bad_image\" });\n      const left = remaining(arrived, tags ? \"tags\" : \"photo\");\n      if (left <= 0) throw Object.assign(new Error(\"stale\"), { name: \"TimeoutError\" });\n      if (tags) {\n        const d = await tagsFromPhoto(opts.ollama, photo, AbortSignal.timeout(left));\n        result = d\n          ? { ...base(job.id, t), ok: true, tags: d }\n          : { ...base(job.id, t), ok: false, error: \"unusable_answer\" };\n      } else {\n        const d = await draftFromPhoto(opts.ollama, photo, AbortSignal.timeout(left));\n        result = d\n          ? { ...base(job.id, t), ok: true, draft: { invite: d.invite, alt: d.alt } }\n          : { ...base(job.id, t), ok: false, error: \"unusable_answer\" };\n      }\n    } catch (e) {\n      const code =\n        (e as { code?: string }).code === \"bad_image\" ? \"bad_image\" : isTimeout(e) ? \"timeout\" : \"model_unavailable\";\n      result = { ...base(job.id, t), ok: false, error: code };\n    } finally {\n      photo.fill(0); // clear the photo bytes as soon as the job ends\n    }\n    send(result, job.kind);\n  };\n\n  const runLadder = async (job: LadderJobT, arrived: number) => {\n    const t = performance.now();\n    let result: HubResult;\n    try {\n      const left = remaining(arrived, \"ladder\");\n      if (left <= 0) throw Object.assign(new Error(\"stale\"), { name: \"TimeoutError\" });\n      const steps = await ladderFromAsk(opts.ollama, job, AbortSignal.timeout(left), {\n        deadline: performance.now() + left,\n      });\n      result = steps\n        ? { ...base(job.id, t), ok: true, ladder: steps }\n        : { ...base(job.id, t), ok: false, error: \"unusable_answer\" };\n    } catch (e) {\n      result = { ...base(job.id, t), ok: false, error: isTimeout(e) ? \"timeout\" : \"model_unavailable\" };\n    }\n    send(result, \"ladder-draft\");\n  };\n\n  const connect = () => {\n    if (stopped) return;\n    ws = new WebSocket(`${opts.serverUrl.replace(/\\/$/, \"\")}/hub`, {\n      headers: { authorization: `Bearer ${opts.secret}` },\n    });\n    ws.on(\"open\", async () => {\n      delay = FIRST_RETRY_MS;\n      lastHeard = Date.now();\n      const ready = await isModelReady(opts.ollama);\n      ws?.send(JSON.stringify({ type: \"hello\", protocol: HUB_PROTOCOL, model: opts.ollama.model, ready }));\n      say({ event: \"connected\", ready });\n    });\n    ws.on(\"message\", (data, isBinary) => {\n      lastHeard = Date.now();\n      if (!isBinary) {\n        let raw: { type?: unknown; kind?: unknown; id?: unknown };\n        try {\n          raw = JSON.parse(String(data));\n        } catch {\n          return;\n        }\n        const m = ToHubV11.safeParse(raw); // ICR-BE-1, ICR-ML5: photo, ladder and tags jobs, pings\n        if (!m.success) {\n          // A ladder job we can't read still gets an answer, so the server needn't wait 8 s.\n          if (raw?.kind === \"ladder-draft\" && typeof raw.id === \"string\")\n            send({ ...base(raw.id, performance.now()), ok: false, error: \"unusable_answer\" }, \"ladder-draft\");\n          return;\n        }\n        const msg = m.data;\n        if (msg.type === \"ping\") ws?.send(JSON.stringify({ type: \"pong\", t: msg.t }));\n        else if (msg.kind === \"photo-draft\" || msg.kind === \"tags-draft\")\n          waitingFor = { id: msg.id, bytes: msg.bytes, kind: msg.kind };\n        else {\n          const arrived = performance.now();\n          enqueue(() => runLadder(msg, arrived));\n        }\n        return;\n      }\n      if (!waitingFor) return;\n      const job = waitingFor;\n      waitingFor = null;\n      const photo = data as Buffer;","is_error":false}]},"uuid":"51d3f510-9bf5-4ed4-a2ec-fa0838092c78","timestamp":"2026-10-11T18:43:45.310Z","toolUseResult":{"stdout":"// Hub relay protocol (docs/architecture/contracts/asyncapi.yaml, channel /hub).\n// The Mac hub opens an outbound WebSocket to the server; the server sends jobs.\n// Text frames carry JSON control messages; a photo job is one text frame (job header)\n// followed by one binary frame (the 768 px JPEG). Nothing on the Mac is exposed (ADR-0006).\nimport { z } from \"zod\";\n\nexport const HUB_PROTOCOL = \"flare-hub.v1\";\n\nexport const HelloFromHub = z.object({\n  type: z.literal(\"hello\"),\n  protocol: z.literal(HUB_PROTOCOL),\n  model: z.string().min(1),\n  ready: z.boolean(),\n});\n\nexport const JobHeader = z.object({\n  type: z.literal(\"job\"),\n  id: z.string().uuid(),\n  kind: z.literal(\"photo-draft\"),\n  bytes: z.number().int().positive().max(2_000_000),\n  mime: z.literal(\"image/jpeg\"),\n});\n\n/** ICR-BE-1: Plan ladder job (asyncapi `ladderJob`). Text only, 8 s budget. */\nexport const LadderJob = z.object({\n  type: z.literal(\"job\"),\n  id: z.string().uuid(),\n  kind: z.literal(\"ladder-draft\"),\n  ask: z.string().max(80),\n  total_minutes: z.number().int().min(40).max(600),\n  weather: z.object({ rain_likely: z.boolean(), temp_f: z.number().int() }).optional(),\n});\n\n/** ICR-ML5: Fix the map photo to OSM tags (asyncapi `tagsJob`). Header frame, then one JPEG\n * frame, like a photo job; 8 s budget. The tags are a draft a person reviews one by one. */\nexport const TagsJob = JobHeader.extend({ kind: z.literal(\"tags-draft\") });\n\nexport const HubLadderStep = z.object({\n  step: z.number().int().min(1).max(4),\n  label: z.string(),\n  minutes: z.number().int(),\n});\n\nexport const JobResult = z.object({\n  type: z.literal(\"result\"),\n  id: z.string().uuid(),\n  ok: z.boolean(),\n  draft: z.object({ invite: z.string().min(1), alt: z.string().min(1) }).optional(),\n  ladder: z.array(HubLadderStep).length(4).optional(), // ICR-BE-1\n  tags: z.record(z.string(), z.string()).optional(), // ICR-ML5, after enforceOsmTags\n  error: z.enum([\"model_unavailable\", \"unusable_answer\", \"timeout\", \"bad_image\"]).optional(),\n  ms: z.number().int().nonnegative(),\n  model: z.string(),\n});\n\nexport const Ping = z.object({ type: z.literal(\"ping\"), t: z.number() });\nexport const Pong = z.object({ type: z.literal(\"pong\"), t: z.number() });\n\nexport const FromHub = z.discriminatedUnion(\"type\", [HelloFromHub, JobResult, Pong]);\nexport const ToHub = z.discriminatedUnion(\"type\", [JobHeader, Ping]);\n      ws.terminate();\n    }\n  }, 1000);\n  watchdog.unref();\n  let waitingFor: { id: string; bytes: number; kind: \"photo-draft\" | \"tags-draft\" } | null = null;\n  // One model call at a time: Ollama is shared on this Mac, and order keeps results simple.\n  let queue: Promise<void> = Promise.resolve();\n  const enqueue = (fn: () => Promise<void>) => {\n    queue = queue.then(fn).catch(() => {});\n  };\n  const send = (r: HubResult, kind: string) => {\n    if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify(r));\n    say({ event: \"job\", kind, ok: r.ok, ms: r.ms });\n  };\n  const base = (id: string, t: number) => ({\n    type: \"result\" as const,\n    id,\n    ms: Math.round(performance.now() - t),\n    model: opts.ollama.model,\n  });\n\n  // The server stops waiting after 6 s (photo) or 8 s (ladder) and answers with the template\n  // (BR-AI-1). Past that, the hub's answer is useless and only delays the next job behind it,\n  // so each job gets the rest of its budget, counted from when it arrived, and is dropped at 0.\n  const budget = {\n    photo: opts.budgetMs?.photo ?? 6000,\n    ladder: opts.budgetMs?.ladder ?? 8000,\n    tags: opts.budgetMs?.tags ?? 8000,\n  };\n  // Whole milliseconds: AbortSignal.timeout() rejects fractions.\n  const remaining = (arrived: number, kind: \"photo\" | \"ladder\" | \"tags\") =>\n    Math.floor(budget[kind] - (performance.now() - arrived));\n  const isTimeout = (e: unknown) => [\"TimeoutError\", \"AbortError\"].includes((e as { name?: string }).name ?? \"\");\n\n  // Photo jobs (invite words, or OSM tags for Fix the map): same frames, different prompt.\n  const runPhoto = async (job: NonNullable<typeof waitingFor>, photo: Buffer, arrived: number) => {\n    const t = performance.now();\n    const tags = job.kind === \"tags-draft\";\n    let result: HubResult;\n    try {\n      if (photo.length !== job.bytes || photo[0] !== 0xff || photo[1] !== 0xd8)\n        throw Object.assign(new Error(\"bad image\"), { code: \"bad_image\" });\n      const left = remaining(arrived, tags ? \"tags\" : \"photo\");\n      if (left <= 0) throw Object.assign(new Error(\"stale\"), { name: \"TimeoutError\" });\n      if (tags) {\n        const d = await tagsFromPhoto(opts.ollama, photo, AbortSignal.timeout(left));\n        result = d\n          ? { ...base(job.id, t), ok: true, tags: d }\n          : { ...base(job.id, t), ok: false, error: \"unusable_answer\" };\n      } else {\n        const d = await draftFromPhoto(opts.ollama, photo, AbortSignal.timeout(left));\n        result = d\n          ? { ...base(job.id, t), ok: true, draft: { invite: d.invite, alt: d.alt } }\n          : { ...base(job.id, t), ok: false, error: \"unusable_answer\" };\n      }\n    } catch (e) {\n      const code =\n        (e as { code?: string }).code === \"bad_image\" ? \"bad_image\" : isTimeout(e) ? \"timeout\" : \"model_unavailable\";\n      result = { ...base(job.id, t), ok: false, error: code };\n    } finally {\n      photo.fill(0); // clear the photo bytes as soon as the job ends\n    }\n    send(result, job.kind);\n  };\n\n  const runLadder = async (job: LadderJobT, arrived: number) => {\n    const t = performance.now();\n    let result: HubResult;\n    try {\n      const left = remaining(arrived, \"ladder\");\n      if (left <= 0) throw Object.assign(new Error(\"stale\"), { name: \"TimeoutError\" });\n      const steps = await ladderFromAsk(opts.ollama, job, AbortSignal.timeout(left), {\n        deadline: performance.now() + left,\n      });\n      result = steps\n        ? { ...base(job.id, t), ok: true, ladder: steps }\n        : { ...base(job.id, t), ok: false, error: \"unusable_answer\" };\n    } catch (e) {\n      result = { ...base(job.id, t), ok: false, error: isTimeout(e) ? \"timeout\" : \"model_unavailable\" };\n    }\n    send(result, \"ladder-draft\");\n  };\n\n  const connect = () => {\n    if (stopped) return;\n    ws = new WebSocket(`${opts.serverUrl.replace(/\\/$/, \"\")}/hub`, {\n      headers: { authorization: `Bearer ${opts.secret}` },\n    });\n    ws.on(\"open\", async () => {\n      delay = FIRST_RETRY_MS;\n      lastHeard = Date.now();\n      const ready = await isModelReady(opts.ollama);\n      ws?.send(JSON.stringify({ type: \"hello\", protocol: HUB_PROTOCOL, model: opts.ollama.model, ready }));\n      say({ event: \"connected\", ready });\n    });\n    ws.on(\"message\", (data, isBinary) => {\n      lastHeard = Date.now();\n      if (!isBinary) {\n        let raw: { type?: unknown; kind?: unknown; id?: unknown };\n        try {\n          raw = JSON.parse(String(data));\n        } catch {\n          return;\n        }\n        const m = ToHubV11.safeParse(raw); // ICR-BE-1, ICR-ML5: photo, ladder and tags jobs, pings\n        if (!m.success) {\n          // A ladder job we can't read still gets an answer, so the server needn't wait 8 s.\n          if (raw?.kind === \"ladder-draft\" && typeof raw.id === \"string\")\n            send({ ...base(raw.id, performance.now()), ok: false, error: \"unusable_answer\" }, \"ladder-draft\");\n          return;\n        }\n        const msg = m.data;\n        if (msg.type === \"ping\") ws?.send(JSON.stringify({ type: \"pong\", t: msg.t }));\n        else if (msg.kind === \"photo-draft\" || msg.kind === \"tags-draft\")\n          waitingFor = { id: msg.id, bytes: msg.bytes, kind: msg.kind };\n        else {\n          const arrived = performance.now();\n          enqueue(() => runLadder(msg, arrived));\n        }\n        return;\n      }\n      if (!waitingFor) return;\n      const job = waitingFor;\n      waitingFor = null;\n      const photo = data as Buffer;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"5c95fb9b-672a-413d-9a2c-42dfe212cfaf","context":{"git_state":{"cwd":"<project>/flare","root":"<project>/flare","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":9,"untracked":null,"untracked_normal":27},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/flare","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/flare","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/flare","visibility":"private"}]}},"live_cwd":"<project>/flare","platform":"macos"}},"sourceToolAssistantUUID":"11b4a93e-32d8-4826-a895-a2abdda41ed1","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"<project>/flare","sessionId":"904c52d9-f200-4552-8ce5-05e400952efa","version":"2.1.295","gitBranch":"HEAD","slug":"wondrous-tumbling-meteor"}
{"parentUuid":"12cbb170-e1d8-4a29-81da-6cac08292cbe","isSidechain":false,"promptId":"e567af3c-70c1-46ba-b5a8-ec342a0e3f0d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NimcxkLN84hfjSUqCo3p3R","type":"tool_result","content":"// Calls Ollama with the settings the lab proved (report 02): GGUF tag, think:false,\n// prompt-only (no format), temperature 0, seed 42. The photo prompt is v2 (photo.ts); the\n// ladder prompt and guard are ML's (packages/shared/src/prompts/ladder.ts, prompt v2).\n// The image is passed as base64 in the request body and lives only in memory.\nimport {\n  type Draft,\n  enforce,\n  enforceLadder,\n  enforceOsmTags,\n  LADDER_PROMPT,\n  type LadderJobT,\n  type LadderT,\n  ladderUserPrompt,\n  OSM_PROMPT,\n  SYSTEM_PROMPT,\n  USER_PROMPT,\n} from \"@flare/shared\";\nimport { WARM_IMAGE_BASE64 } from \"./warm-image.ts\";\n\nexport type OllamaConfig = { url: string; model: string; timeoutMs: number };\n\nasync function post(cfg: OllamaConfig, messages: unknown[], numPredict: number, signal?: AbortSignal): Promise<string> {\n  const res = await fetch(`${cfg.url}/api/chat`, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\" },\n    body: JSON.stringify({\n      model: cfg.model,\n      stream: false,\n      think: false,\n      keep_alive: \"30m\",\n      messages,\n      options: { temperature: 0, seed: 42, num_predict: numPredict },\n    }),\n    signal: signal ?? AbortSignal.timeout(cfg.timeoutMs),\n  });\n  if (!res.ok) throw new Error(`ollama ${res.status}`);\n  const json = (await res.json()) as { message?: { content?: string } };\n  return json.message?.content ?? \"\";\n}\n\n/** The photo task: system prompt v2 plus one image. */\nexport function chat(cfg: OllamaConfig, imageBase64: string, signal?: AbortSignal, numPredict = 128): Promise<string> {\n  return post(\n    cfg,\n    [\n      { role: \"system\", content: SYSTEM_PROMPT },\n      { role: \"user\", content: USER_PROMPT, images: [imageBase64] },\n    ],\n    numPredict,\n    signal,\n  );\n}\n\n/**\n * Warm the model the way photos use it: the real system prompt plus an image, 4 tokens out.\n * A text-only warm-up left the vision path cold, and the first photos took 12 to 17 s (ML F16).\n */\nexport function warm(cfg: OllamaConfig): Promise<string> {\n  return chat(cfg, WARM_IMAGE_BASE64, AbortSignal.timeout(120_000), 4);\n}\n\n/** One photo in, one guarded draft out. Retries once on an unusable answer (report 02). */\nexport async function draftFromPhoto(cfg: OllamaConfig, jpeg: Uint8Array, signal?: AbortSignal): Promise<Draft | null> {\n  const b64 = Buffer.from(jpeg).toString(\"base64\");\n  for (let attempt = 0; attempt < 2; attempt++) {\n    const text = await chat(cfg, b64, signal);\n    const d = enforce(text);\n    if (d) return d;\n  }\n  return null;\n}\n\n/** Ask line to four steps with ML's ladder prompt v2 and enforceLadder(). No retry by default (ADR-0025). */\nexport async function ladderFromAsk(\n  cfg: OllamaConfig,\n  job: LadderJobT,\n  signal?: AbortSignal,\n  opts: { retry?: LadderRetry; deadline?: number } = {},\n): Promise<LadderT | null> {\n  const input = { ask: job.ask, total_minutes: job.total_minutes, ...(job.weather ? { weather: job.weather } : {}) };\n  const messages: { role: string; content: string }[] = [\n    { role: \"system\", content: LADDER_PROMPT.system },\n    { role: \"user\", content: ladderUserPrompt(input) },\n  ];\n  const t0 = performance.now();\n  const text = await post(cfg, messages, LADDER_PROMPT.numPredict, signal);\n  const d = enforceLadder(text, input);\n  if (d) return d.ladder;\n  // At temperature 0 the same prompt gives the same answer, so a plain retry only costs time\n  // (about 3.5 s, eval 2026-10-11). \"corrective\" retries once with a correction, only if one\n  // more call of the same length fits before the deadline. The default is \"none\": in the eval\n  // Gemma kept the same labels after the correction, so the template takes over at once.\n  const retry = opts.retry ?? LADDER_RETRY;\n  const took = performance.now() - t0;\n  if (retry === \"none\" || (opts.deadline !== undefined && performance.now() + took > opts.deadline)) return null;\n  const again = await post(\n    cfg,\n    [...messages, { role: \"assistant\", content: text }, { role: \"user\", content: LADDER_CORRECTION }],\n    LADDER_PROMPT.numPredict,\n    signal,\n  );\n  return enforceLadder(again, input)?.ladder ?? null;\n}\n\nexport type LadderRetry = \"corrective\" | \"none\";\n/** Chosen by the ladder-agent eval (ADR-0025): see docs/handoffs/10-mastra-plan.md. */\nexport const LADDER_RETRY: LadderRetry = \"none\";\n/** The second turn when the first answer failed enforceLadder(). Names the usual failures. */\nexport const LADDER_CORRECTION =\n  \"That answer could not be used. Reply with the JSON object only: 4 labels of 2 to 4 plain words in sentence case (only the first letter upper case), only places named in the ask, and 4 whole minutes that go down.\";\n\n/**\n * ICR-ML5: one photo to a guarded OSM tag draft with ML's osm-tags prompt v1 and\n * enforceOsmTags(). Retries once when the answer is not JSON. Empty tags is a valid answer.\n */\nexport async function tagsFromPhoto(\n  cfg: OllamaConfig,\n  jpeg: Uint8Array,\n  signal?: AbortSignal,\n): Promise<Record<string, string> | null> {\npackages/shared/src/photo.ts:13:export const SYSTEM_PROMPT = [\npackages/shared/src/photo.ts-14-  \"You write invites for Flare, an app that gets close friends to meet up outside, right now.\",\npackages/shared/src/photo.ts-15-  \"Look at the photo of the spot. Reply with one JSON object only. No code fences, no other text.\",\npackages/shared/src/photo.ts-16-  '{\"invite\": \"...\", \"alt\": \"...\"}',\npackages/shared/src/photo.ts-17-  \"invite: 3 to 6 words, never more. A warm call to meet at this exact spot.\",\npackages/shared/src/photo.ts-18-  \"alt: 8 to 20 words. A plain spoken description of the place for a friend who cannot see the photo.\",\npackages/shared/src/photo.ts-19-  \"Mention only things clearly visible. Do not invent water, food, drinks or activities you cannot see.\",\npackages/shared/src/photo.ts-20-  'Describe the place only. Never describe faces, bodies, clothing, age, gender or who anyone is. If people appear, say \"people\" or \"a group\".',\npackages/shared/src/photo.ts-21-  \"No names, no emoji, no hashtags.\",\npackages/shared/src/photo.ts-22-  'Example: {\"invite\": \"Golden hour at the rooftop garden\", \"alt\": \"A rooftop garden with raised flower beds, wooden chairs and a low railing above the city.\"}',\npackages/shared/src/photo.ts-23-].join(\"\\n\");\npackages/shared/src/photo.ts-24-\npackages/shared/src/photo.ts-25-export const USER_PROMPT = \"Here is the photo. Reply with the JSON.\";\npackages/shared/src/photo.ts-26-\npackages/shared/src/photo.ts-27-/** Template used when the hub is unreachable or the answer can't be used (FR-AI-1 rules tier). */\npackages/shared/src/photo.ts-28-export const TEMPLATE_INVITE = \"Outside right now. Come?\";\npackages/shared/src/photo.ts-29-\npackages/shared/src/photo.ts-30-/** Raw answer shape before the guard. Extra keys are ignored. */\npackages/shared/src/photo.ts-31-export const PhotoAnswer = z.object({ invite: z.string(), alt: z.string() });\npackages/shared/src/photo.ts-32-\npackages/shared/src/photo.ts-33-/** Guarded draft shape the hub returns and the server re-checks (asyncapi result.draft). */","is_error":false}]},"uuid":"0f6fc191-efd6-445d-8452-10c248ee587c","timestamp":"2026-10-11T18:43:45.317Z","toolUseResult":{"stdout":"// Calls Ollama with the settings the lab proved (report 02): GGUF tag, think:false,\n// prompt-only (no format), temperature 0, seed 42. The photo prompt is v2 (photo.ts); the\n// ladder prompt and guard are ML's (packages/shared/src/prompts/ladder.ts, prompt v2).\n// The image is passed as base64 in the request body and lives only in memory.\nimport {\n  type Draft,\n  enforce,\n  enforceLadder,\n  enforceOsmTags,\n  LADDER_PROMPT,\n  type LadderJobT,\n  type LadderT,\n  ladderUserPrompt,\n  OSM_PROMPT,\n  SYSTEM_PROMPT,\n  USER_PROMPT,\n} from \"@flare/shared\";\nimport { WARM_IMAGE_BASE64 } from \"./warm-image.ts\";\n\nexport type OllamaConfig = { url: string; model: string; timeoutMs: number };\n\nasync function post(cfg: OllamaConfig, messages: unknown[], numPredict: number, signal?: AbortSignal): Promise<string> {\n  const res = await fetch(`${cfg.url}/api/chat`, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\" },\n    body: JSON.stringify({\n      model: cfg.model,\n      stream: false,\n      think: false,\n      keep_alive: \"30m\",\n      messages,\n      options: { temperature: 0, seed: 42, num_predict: numPredict },\n    }),\n    signal: signal ?? AbortSignal.timeout(cfg.timeoutMs),\n  });\n  if (!res.ok) throw new Error(`ollama ${res.status}`);\n  const json = (await res.json()) as { message?: { content?: string } };\n  return json.message?.content ?? \"\";\n}\n\n/** The photo task: system prompt v2 plus one image. */\nexport function chat(cfg: OllamaConfig, imageBase64: string, signal?: AbortSignal, numPredict = 128): Promise<string> {\n  return post(\n    cfg,\n    [\n      { role: \"system\", content: SYSTEM_PROMPT },\n      { role: \"user\", content: USER_PROMPT, images: [imageBase64] },\n    ],\n    numPredict,\n    signal,\n  );\n}\n\n/**\n * Warm the model the way photos use it: the real system prompt plus an image, 4 tokens out.\n * A text-only warm-up left the vision path cold, and the first photos took 12 to 17 s (ML F16).\n */\nexport function warm(cfg: OllamaConfig): Promise<string> {\n  return chat(cfg, WARM_IMAGE_BASE64, AbortSignal.timeout(120_000), 4);\n}\n\n/** One photo in, one guarded draft out. Retries once on an unusable answer (report 02). */\nexport async function draftFromPhoto(cfg: OllamaConfig, jpeg: Uint8Array, signal?: AbortSignal): Promise<Draft | null> {\n  const b64 = Buffer.from(jpeg).toString(\"base64\");\n  for (let attempt = 0; attempt < 2; attempt++) {\n    const text = await chat(cfg, b64, signal);\n    const d = enforce(text);\n    if (d) return d;\n  }\n  return null;\n}\n\n/** Ask line to four steps with ML's ladder prompt v2 and enforceLadder(). No retry by default (ADR-0025). */\nexport async function ladderFromAsk(\n  cfg: OllamaConfig,\n  job: LadderJobT,\n  signal?: AbortSignal,\n  opts: { retry?: LadderRetry; deadline?: number } = {},\n): Promise<LadderT | null> {\n  const input = { ask: job.ask, total_minutes: job.total_minutes, ...(job.weather ? { weather: job.weather } : {}) };\n  const messages: { role: string; content: string }[] = [\n    { role: \"system\", content: LADDER_PROMPT.system },\n    { role: \"user\", content: ladderUserPrompt(input) },\n  ];\n  const t0 = performance.now();\n  const text = await post(cfg, messages, LADDER_PROMPT.numPredict, signal);\n  const d = enforceLadder(text, input);\n  if (d) return d.ladder;\n  // At temperature 0 the same prompt gives the same answer, so a plain retry only costs time\n  // (about 3.5 s, eval 2026-10-11). \"corrective\" retries once with a correction, only if one\n  // more call of the same length fits before the deadline. The default is \"none\": in the eval\n  // Gemma kept the same labels after the correction, so the template takes over at once.\n  const retry = opts.retry ?? LADDER_RETRY;\n  const took = performance.now() - t0;\n  if (retry === \"none\" || (opts.deadline !== undefined && performance.now() + took > opts.deadline)) return null;\n  const again = await post(\n    cfg,\n    [...messages, { role: \"assistant\", content: text }, { role: \"user\", content: LADDER_CORRECTION }],\n    LADDER_PROMPT.numPredict,\n    signal,\n  );\n  return enforceLadder(again, input)?.ladder ?? null;\n}\n\nexport type LadderRetry = \"corrective\" | \"none\";\n/** Chosen by the ladder-agent eval (ADR-0025): see docs/handoffs/10-mastra-plan.md. */\nexport const LADDER_RETRY: LadderRetry = \"none\";\n/** The second turn when the first answer failed enforceLadder(). Names the usual failures. */\nexport const LADDER_CORRECTION =\n  \"That answer could not be used. Reply with the JSON object only: 4 labels of 2 to 4 plain words in sentence case (only the first letter upper case), only places named in the ask, and 4 whole minutes that go down.\";\n\n/**\n * ICR-ML5: one photo to a guarded OSM tag draft with ML's osm-tags prompt v1 and\n * enforceOsmTags(). Retries once when the answer is not JSON. Empty tags is a valid answer.\n */\nexport async function tagsFromPhoto(\n  cfg: OllamaConfig,\n  jpeg: Uint8Array,\n  signal?: AbortSignal,\n): Promise<Record<string, string> | null> {\npackages/shared/src/photo.ts:13:export const SYSTEM_PROMPT = [\npackages/shared/src/photo.ts-14-  \"You write invites for Flare, an app that gets close friends to meet up outside, right now.\",\npackages/shared/src/photo.ts-15-  \"Look at the photo of the spot. Reply with one JSON object only. No code fences, no other text.\",\npackages/shared/src/photo.ts-16-  '{\"invite\": \"...\", \"alt\": \"...\"}',\npackages/shared/src/photo.ts-17-  \"invite: 3 to 6 words, never more. A warm call to meet at this exact spot.\",\npackages/shared/src/photo.ts-18-  \"alt: 8 to 20 words. A plain spoken description of the place for a friend who cannot see the photo.\",\npackages/shared/src/photo.ts-19-  \"Mention only things clearly visible. Do not invent water, food, drinks or activities you cannot see.\",\npackages/shared/src/photo.ts-20-  'Describe the place only. Never describe faces, bodies, clothing, age, gender or who anyone is. If people appear, say \"people\" or \"a group\".',\npackages/shared/src/photo.ts-21-  \"No names, no emoji, no hashtags.\",\npackages/shared/src/photo.ts-22-  'Example: {\"invite\": \"Golden hour at the rooftop garden\", \"alt\": \"A rooftop garden with raised flower beds, wooden chairs and a low railing above the city.\"}',\npackages/shared/src/photo.ts-23-].join(\"\\n\");\npackages/shared/src/photo.ts-24-\npackages/shared/src/photo.ts-25-export const USER_PROMPT = \"Here is the photo. Reply with the JSON.\";\npackages/shared/src/photo.ts-26-\npackages/shared/src/photo.ts-27-/** Template used when the hub is unreachable or the answer can't be used (FR-AI-1 rules tier). */\npackages/shared/src/photo.ts-28-export const TEMPLATE_INVITE = \"Outside right now. Come?\";\npackages/shared/src/photo.ts-29-\npackages/shared/src/photo.ts-30-/** Raw answer shape before the guard. Extra keys are ignored. */\npackages/shared/src/photo.ts-31-export const PhotoAnswer = z.object({ invite: z.string(), alt: z.string() });\npackages/shared/src/photo.ts-32-\npackages/shared/src/photo.ts-33-/** Guarded draft shape the hub returns and the server re-checks (asyncapi result.draft). */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"5c95fb9b-672a-413d-9a2c-42dfe212cfaf","context":{"git_state":{"cwd":"<project>/flare","root":"<project>/flare","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":9,"untracked":null,"untracked_normal":27},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/flare","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/flare","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/flare","visibility":"private"}]}},"live_cwd":"<project>/flare","platform":"macos"}},"sourceToolAssistantUUID":"12cbb170-e1d8-4a29-81da-6cac08292cbe","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"<project>/flare","sessionId":"904c52d9-f200-4552-8ce5-05e400952efa","version":"2.1.295","gitBranch":"HEAD","slug":"wondrous-tumbling-meteor"}
