k).find((p) => p.osm_id === named?.key)?.kind === \"street\")\n      named = { ...named, name: t(\"spot.nearStreet\", { street: named.name }) };''')])\n# c, d, e: demo\np='apps/web/src/routes/app/demo/+page.svelte'\ns=open(p).read()\ns=s.replace('''  .demo.coach :global(.actions) { visibility: hidden; }''','''  .demo.coach :global(.actions) { display: none; } /* out of the page, not only out of sight */''',1)\nassert '''sentMin={0}''' in s\ns=s.replace('''sentMin={0}''','''sentMin={sentAt ? Math.floor((demo.now - sentAt) / 60_000) : 0}''',1)\ns=s.replace('''  let litAt = 0;''','''  let litAt = 0;\n  let sentAt = $state(0); // the demo clock when you sent it, so \"Sent 30 min ago\" follows the skip''',1)\ns=s.replace('''    demo.start(Number(quorum));''','''    demo.start(Number(quorum));\n    sentAt = demo.now;''',1)\ns=s.replace('''    {#if step !== \"send\" && step !== \"done\"}<p class=\"who\">''','''    <!-- A way out on every step, also where the screen itself has no X (fresh-eyes round 5). -->\n    {#if [\"friendIn\", \"here\", \"spark\", \"outside\", \"done\"].includes(step)}<button class=\"out\" aria-label={t(\"app.close\")} onclick={leave}>✕</button>{/if}\n    {#if step !== \"send\" && step !== \"done\"}<p class=\"who\">''',1)\ns=s.replace('''  .notes { display: contents; }''','''  .notes { display: contents; }\n  .out { position: fixed; top: calc(env(safe-area-inset-top, 0) + 10px); right: 12px; z-index: 31; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgb(0 0 0 / 0.45); color: #fff; font-size: 1.1rem; }''',1)\nopen(p,'w').write(s)\n# f: gap\nedit('apps/web/src/routes/(site)/site.css',[('''.site .band {\n  padding: 56px 20px;''','''.site .band.feat {\n  padding-top: 8px; /* follows a band of the same colour: no doubled gap (fresh-eyes round 5) */\n}\n.site .band {\n  padding: 56px 20px;''')])\nEOF\ngrep -n \"packPlaces\" apps/web/src/lib/screens/flow/host.svelte.ts | head -2; (cd apps/web && npx svelte-check --threshold warning 2>&