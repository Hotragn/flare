ages/shared/src/icd/engine.ts:18:  | { type: \"after\"; at: Iso }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"1eb26ad4-deda-4448-93e8-545ae614217f","context":{"git_state":{"cwd":"<project>/flare","root":"<project>/flare","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":28,"untracked":null,"untracked_normal":5},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/flare","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/flare","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/flare","visibility":"private"}]}},"live_cwd":"<project>/flare","platform":"macos"}},"sourceToolAssistantUUID":"b0331ef2-f2e2-4962-a820-af2b3779a155","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"<project>/flare","sessionId":"904c52d9-f200-4552-8ce5-05e400952efa","version":"2.1.295","gitBranch":"HEAD","slug":"wondrous-tumbling-meteor"}
