{"parentUuid":"16b2ae3f-7c71-4b61-8afc-1ba2d7edf6f8","isSidechain":false,"promptId":"f93043c4-458a-4d94-b158-9e5f79350398","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EmTcR5uf98fdPuwPuiBmZz","type":"tool_result","content":"9:  let {\n41:    <TextField label={t(\"spark.label\")} bind:value={line} placeholder={t(\"spark.placeholder\")} {error} max={140} multiline />\n<!-- I11 Spark: one line in your own words, once, optional (BR-K-1 to -3). No AI help offered. -->\n<script lang=\"ts\">\n  import Screen from \"../components/Screen.svelte\";\n  import Button from \"../components/Button.svelte\";\n  import TextField from \"../components/TextField.svelte\";\n  import Icon from \"../components/Icon.svelte\";\n  import { t } from \"#lib/copy/index.ts\";\n  import type { Theme } from \"../components/parts\";\n  let {\n    view = \"empty\",\n    theme = \"light\",\n    line = $bindable(\"\"),\n    error = \"\",\n    busy = false,\n    onsave,\n    onskip,\n  }: {\n    view?: \"empty\" | \"saved\";\n    theme?: Theme;\n    line?: string;\n    error?: string;\n    busy?: boolean;\n    onsave?: (line: string) => void;\n    onskip?: () => void;\n  } = $props();\n</script>\n\n<Screen {theme} onclose={onskip}>\n  {#if view === \"saved\"}\n    <div class=\"center\">\n      <Icon name=\"spark\" size={56} />\n      <h1 class=\"t-title\">{t(\"spark.saved\")}</h1>\n      <p>{t(\"spark.savedBody\")}</p>\n    </div>\n  {:else}\n    <div class=\"intro\">\n      <Icon name=\"spark\" size={40} />\n      <h1 class=\"t-title\">{t(\"spark.prompt\")}</h1>\n      <p class=\"t-muted\">{t(\"spark.body\")}</p>\n    </div>\n    <TextField label={t(\"spark.label\")} bind:value={line} placeholder={t(\"spark.placeholder\")} {error} max={140} multiline />\n  {/if}\n  {#snippet actions()}\n    {#if view === \"saved\"}\n      <Button variant=\"secondary\" onclick={onskip}>{t(\"gone.close\")}</Button>\n    {:else}\n      <Button loading={busy} onclick={() => onsave?.(line.trim(