 with a bench in warm evening light.\"}', seen);\n    expect(r).toMatchObject({ id: \"66666666-2b7a-4d8e-9c3f-1a2b3c4d5e6f\", ok: true });\n    expect(r.draft).toEqual({ invite: \"Meet at the pond bench\", alt: \"A pond in a park with a bench in warm evening light.\" });\n    expect(seen).toEqual([{ system: VOICE_SYSTEM_PROMPT, image: true }]);\n  });\n  it(\"no place heard: unusable_answer, so the phone asks the host to type\", async () => {\n    const r = await runVoice('{\"invite\": \"\", \"alt\": \"\"}', []);\n    expect(r).toMatchObject({ ok: false, error: \"unusable_answer\" });\n  });\n  it(\"a frame that is not WAV is bad_audio and never reaches the model\", async () => {\n    const seen: Seen[] = [];\n    const r = await runVoice(\"{}\", seen, Buffer.alloc(300, 1));\n    expect(r).toMatchObject({ ok: false, error: \"bad_audio\" });\n    expect(seen).toHaveLength(0);\n  });\n});\n'''\nopen('apps/hub/test/voice.test.ts','w').write(s)\nEOF\nnpx biome check --write apps/hub/test/voice.test.ts >/dev/null 2>&1; npx vitest run apps/hub/test 2>&1 | grep -E \"Tests |FAIL|✗\" | head","description":"Hub voice job tests","timeout":300000}},"serverClassifierRequest":"6304860d-5978-49e0-b0e8-37b1522229ee","apiBlockIndex":0,"requestId":"req_011Cfvwssmi4CxTv3oM44nSY","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"b5b74ee7-e864-4b12-a3bf-00a9fd0bb4cc","timestamp":"2026-10-11T18:46:45.184Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"<project>/flare","sessionId":"904c52d9-f200-4552-8ce5-05e400952efa","version":"2.1.295","gitBranch":"HEAD","slug":"wondrous-tumbling-meteor"}
