it on or off for this Flare (ADR-0031)\",\"Host only. Off by default; turning it off clears every consent and any recording.\",js('{ type: object, additionalProperties: false, required: [on], properties: { on: { type: boolean } } }'),\"State\")\nblock += \"  /api/v1/gatherings/{gatheringId}/remember/consent:\\n\" + op(\"put\",\"consentRemember\",\"Remember this: one person agrees, or not, on their own phone (ADR-0031)\",\"Any no keeps it off for everyone and stops a recording at once.\",js('{ type: object, additionalProperties: false, required: [ok], properties: { ok: { type: boolean } } }'),\"State\")\nblock += \"  /api/v1/gatherings/{gatheringId}/remember/record:\\n\" + op(\"post\",\"recordRemember\",\"Remember this: start (when ready) or stop (anyone, for everyone) (ADR-0031)\",\"Start needs every yes to have agreed and the gathering lit; it records up to 60 s on that phone. Every phone gets the sign live (SSE event remember).\",js('{ type: object, additionalProperties: false, required: [action], properties: { action: { type: string, enum: [start, stop] } } }'),\"State\")\nblock += \"  /api/v1/gatherings/{gatheringId}/remember/transcribe:\\n\" + op(\"post\",\"transcribeRemember\",\"Remember this: the recording to speaker-labelled lines, once (ADR-0031)\",\"Audio up to 1.2 MB, sent once to ElevenLabs Scribe v2 with speaker labels (Speaker 1, 2), zero-filled after; nothing kept. 503 without an ElevenLabs key.\",'          audio/webm:\\n            schema: { type: string, maxLength: 1200000 }\\n          audio/mp4:\\n            schema: { type: string, maxLength: 1200000 }',\"Lines\")\nblock += \"  /api/v1/gatherings/{gatheringId}/remember/summary:\\n\" + op(\"post\",\"summarizeRemember\",\"Remember this: one line from Gemma on the hub (ADR-0031)\",\"Hub only; with the hub off, line is null and the text never goes to a cloud model.\",js('{ type: object, additionalProperties: false, required: [text], properties: { text: { type: string, maxLength: 4000 } } }'),\"Line\")\nblock += \"  /api/v1/gatherings/{gatheringId}/remember/note:\\n\" + op(\"put\",\"noteRemember\",\"Remember this: store the note, sealed on the phone with the Flare key (ADR-0031)\",\"The server can't read it; deleted with the gathering at Gone (audit DS12).\",js('{ type: object, additionalProperties: false, required: [note_ct], properties: { note_ct: { type: string, maxLength: 32004 } } }'),\"State\")\nanchor='  /api/v1/groups/{groupId}/stats:'\nassert anchor in s\ns=s.replace(anchor, block+\"\\n\"+anchor,1)\nschemas_anchor='    Error:'\nschema='''    RememberState:\n      type: object\n      description: Remember this (ADR-0031). Flags only, never who; GET adds my_ok, is_host, note_ct; transcribe answers lines; summary answers line and tier.\n      properties:\n        on: { type: boolean }\n        ready: { type: boolean }\n        recording: { type: boolean }\n        recording_until: { type: [string, \"null\"], format: date-time }\n        has_note: { type: boolean }\n        my_ok: { type: [boolean, \"null\"] }\n        is_host: { type: boolean }\n        note_ct: { type: [string, \"null\"] }\n        lines: { type: [array, \"null\"], items: { type: object, properties: { speaker: { type: string }, text: { type: string } } } }\n        line: { type: [string, \"null\"] }\n        tier: { type: string, enum: [hub, none] }\n'''\ns=s.replace(schemas_anchor, schema+schemas_anchor,1)\nopen(p,'w').write(s)\np='docs/architecture/contracts/asyncapi.yaml'\ns=open(p).read()\ns=s.replace('''      voiceJob: { $ref: \"#/components/messages/voiceJob\" }''','''      voiceJob: { $ref: \"#/components/messages/voiceJob\" }\n      summaryJob: { $ref: \"#/components/messages/summaryJob\" }''',1)\ns=s.replace('''  hubSendsResult:''','''  serverSendsSummaryJob:\n    action: receive\n    channel: { $ref: \"#/channels/hub\" }\n    summary: \"ADR-0031: a consented Remember this transcript to one line (text only, 8 s)\"\n    messages:\n      - $ref: \"#/channels/hub/messages/summaryJo