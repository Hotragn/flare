{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!lab",
      "!design",
      "!brand",
      "!docs",
      "!apps/web/.svelte-kit",
      "!apps/web/build",
      "!**/*.svelte",
      "!packages/contracts/*.yaml"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": { "level": "error", "options": { "allow": ["error", "warn", "info"] } } }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
